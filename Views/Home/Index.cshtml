@using MyMusicBuddy.Services
@{
    ViewData["Title"] = "首頁";
}

<h1 class="mb-page-title">一張照片,一份可以播放的歌單</h1>
<p class="mb-muted" style="max-width: 560px">
    上傳照片、選一種情緒,MusicBuddy 幫你把當下的氛圍變成歌單。
</p>

<div class="mb-chips my-4">
    @foreach (var mood in MoodKeywordMapper.AllMoods)
    {
        <a class="mb-chip text-decoration-none" asp-controller="Works" asp-action="Create">@mood</a>
    }
</div>

<div class="d-flex gap-3 mt-4">
    <a asp-controller="Works" asp-action="Create" class="mb-btn">建立新作品</a>
    <a asp-controller="Works" asp-action="Index" class="mb-btn mb-btn-outline">我的作品</a>
</div>
