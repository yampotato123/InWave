@model InWave.Models.ViewModels.RecommendViewModel
@{
    ViewData["Title"] = "推薦歌單";
}

<main class="iw-page" style="max-width:1080px">
    <div class="iw-mono">Step 03 · @(string.IsNullOrEmpty(Model.MoodName) ? "待 AI 判讀" : Model.MoodName)</div>
    <h1 class="iw-serif" style="margin:12px 0 6px;font-size:46px;line-height:1.1">推薦歌單</h1>
    <div class="iw-mono" style="color:var(--accent);margin-bottom:34px">
        @Model.SearchKeyword
        @if (Model.AnalyzedAt != null)
        {
            <span style="color:var(--muted)">
                　判讀於 @Model.AnalyzedAt.Value.ToLocalTime().ToString("MM/dd HH:mm")
            </span>
            @* 判讀要 16–105 秒,按鈕送出後停用,避免重複點擊各打一次 AI *@
            <form asp-action="Reanalyze" method="post" style="display:inline"
                  onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='判讀中…'">
                <input type="hidden" name="photoId" value="@Model.PhotoId" />
                <button type="submit" class="iw-pill" style="margin-left:10px">重新判讀</button>
            </form>
        }
        @if (TempData["ReanalyzeError"] is string reanalyzeError)
        {
            <div style="color:var(--muted);margin-top:8px">
                重新判讀沒有成功(@reanalyzeError),先前的判讀結果保留著。稍後可以再試一次。
            </div>
        }
    </div>

    <div style="display:grid;grid-template-columns:340px 1fr;gap:40px;align-items:start">
        <div>
            <div class="iw-glass" style="padding:14px">
                <img src="@Model.PhotoPath" alt="作品照片"
                     style="width:100%;border-radius:10px;display:block" />
            </div>
            @*
                試聽區。先前這裡放的是 <iframe src="">——空字串的 src 會被解析成「當前頁網址」,
                等於一開始就多載一份東西進來,而且畫面上看不出是播放器。
                改成先放提示,按「試聽」時才動態建立 iframe。
            *@
            <div id="preview-box" class="iw-glass ratio ratio-16x9" style="margin-top:14px;
                 display:flex;align-items:center;justify-content:center">
                <div class="iw-mono" id="preview-hint" style="text-align:center;line-height:1.9">
                    點右側任一首的<br>「試聽」在這裡播放
                </div>
            </div>
        </div>

        <div>
            <div asp-validation-summary="All" class="mb-errors"></div>

            <form asp-action="SavePlaylist" method="post">
                <input type="hidden" asp-for="PhotoId" />
                <input type="hidden" asp-for="PhotoPath" />
                <input type="hidden" asp-for="MoodName" />
                <input type="hidden" asp-for="SearchKeyword" />

                <div class="iw-mono" style="margin-bottom:10px">歌單名稱 Playlist name</div>
                <input asp-for="PlaylistName" class="mb-input" placeholder="幫這份歌單取個名字"
                       style="font-family:inherit" />

                <div class="iw-mono" style="margin:30px 0 10px">
                    勾選要收進歌單的歌 · @Model.Songs.Count 首
                </div>

                <div class="iw-glass" style="padding:6px 8px">
                    @for (var i = 0; i < Model.Songs.Count; i++)
                    {
                        <div class="iw-track">
                            <input type="hidden" asp-for="Songs[i].VideoId" />
                            <input type="hidden" asp-for="Songs[i].Title" />
                            <input type="hidden" asp-for="Songs[i].Artist" />
                            <input type="hidden" asp-for="Songs[i].ThumbnailUrl" />

                            <input class="form-check-input" type="checkbox" asp-for="Songs[i].Selected"
                                   title="加入歌單" style="flex:none" />
                            <img src="@Model.Songs[i].ThumbnailUrl" alt=""
                                 style="width:44px;height:32px;border-radius:5px;object-fit:cover;flex:none" />
                            <span style="min-width:0;flex:1;display:flex;flex-direction:column;gap:3px">
                                <span style="font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@Model.Songs[i].Title</span>
                                <span style="font-size:11px;color:rgba(255,255,255,.45);font-weight:300">@Model.Songs[i].Artist</span>
                            </span>
                            <button type="button" class="iw-pill preview-btn" data-video-id="@Model.Songs[i].VideoId">試聽</button>
                        </div>
                    }
                </div>

                @if (Model.Songs.Count == 0)
                {
                    <div class="iw-glass" style="padding:48px;text-align:center;color:var(--muted)">
                        找不到歌曲——可能是 API 額度用完或網路問題,請稍後再試。
                    </div>
                }

                <button type="submit" class="iw-btn" style="margin-top:28px">儲存歌單 →</button>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // 點「試聽」在左側播放。iframe 到這時才建立——頁面一開始不需要它,
        // 也避免空 src 被解析成當前頁網址。
        const box = document.getElementById("preview-box");
        let frame = null;

        document.querySelectorAll(".preview-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                if (!frame) {
                    document.getElementById("preview-hint")?.remove();
                    frame = document.createElement("iframe");
                    frame.title = "試聽";
                    frame.allow = "autoplay; encrypted-media";
                    frame.allowFullscreen = true;
                    frame.style.border = "none";
                    box.appendChild(frame);
                }
                frame.src = `https://www.youtube.com/embed/${btn.dataset.videoId}?autoplay=1`;

                // 播放器在左欄,視窗不夠高時會在畫面外——按了卻看不到東西動,
                // 會以為功能壞了。捲進視野再標示目前播放中的是哪一首。
                box.scrollIntoView({ behavior: "smooth", block: "nearest" });
                document.querySelectorAll(".preview-btn").forEach(b => b.classList.remove("is-on"));
                btn.classList.add("is-on");
            });
        });
    </script>
}
