@model InWave.Models.Playlist
@{
    ViewData["Title"] = Model.Name;
    var songs = Model.PlaylistSongs.Select(ps => ps.Song).ToList();
    var first = songs.FirstOrDefault();
}

<main class="iw-stage">
    <div class="photo"><img src="@(Model.Photo?.EditedPath ?? Model.Photo?.OriginalPath)" alt="@Model.Name"></div>
    <div class="veil"></div>

    <div style="position:relative;z-index:10;display:grid;grid-template-columns:1fr 400px;gap:48px;align-items:end;height:100%;padding:0 44px 128px">
        <div>
            <div class="iw-mono" style="color:var(--accent);letter-spacing:.3em">@Model.Photo?.Mood?.MoodName</div>
            <h1 class="iw-serif" style="margin:16px 0 0;font-size:82px;line-height:1;text-shadow:0 8px 40px rgba(0,0,0,.7)">@Model.Name</h1>
            <div class="iw-mono" style="display:flex;gap:26px;margin-top:20px;color:rgba(255,255,255,.62)">
                <span>@Model.CreatedAt.ToLocalTime().ToString("yyyy.MM.dd")</span><span>@songs.Count tracks</span>
            </div>
            <div style="display:flex;align-items:center;gap:18px;margin-top:34px">
                <div class="iw-disc"></div>
                <div>
                    <div id="npTitle" style="font-size:22px;font-weight:600;letter-spacing:-.02em">@first?.Title</div>
                    <div id="npArtist" style="margin-top:6px;font-size:13px;color:rgba(255,255,255,.55);font-weight:300">@first?.Artist</div>
                </div>
            </div>
        </div>

        <aside class="iw-glass" style="align-self:end;max-height:62vh;display:flex;flex-direction:column">
            <div class="iw-mono" style="display:flex;justify-content:space-between;padding:15px 20px;border-bottom:1px solid var(--line);font-size:10px">
                <span>歌單 Tracklist</span><span>@songs.Count</span>
            </div>
            <div style="overflow:auto;padding:6px 8px">
                @for (var i = 0; i < songs.Count; i++)
                {
                    <div class="iw-track @(i == 0 ? "is-on" : "")" data-i="@i" data-vid="@songs[i].YoutubeVideoId">
                        <span class="iw-mono" style="width:18px;flex:none;font-size:11px;letter-spacing:0">@((i + 1).ToString("00"))</span>
                        <img src="@songs[i].ThumbnailUrl" alt="" style="width:44px;height:32px;border-radius:5px;object-fit:cover;flex:none">
                        <span style="min-width:0;display:flex;flex-direction:column;gap:3px">
                            <span style="font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@songs[i].Title</span>
                            <span style="font-size:11px;color:rgba(255,255,255,.45);font-weight:300;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@songs[i].Artist</span>
                        </span>
                    </div>
                }
            </div>
        </aside>
    </div>
</main>

<footer class="iw-player">
    <div style="display:flex;align-items:center;gap:14px;min-width:0">
        <div class="iw-eq"><i></i><i></i><i></i></div>
        <div style="min-width:0">
            <div id="barTitle" style="font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@first?.Title</div>
            <div id="barArtist" style="font-size:11px;color:rgba(255,255,255,.45);font-weight:300">@first?.Artist</div>
        </div>
    </div>
    <div style="display:flex;align-items:center;gap:18px">
        <span id="prev" style="cursor:pointer;color:rgba(255,255,255,.5)">◀◀</span>
        <span id="toggle" style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:#fff;color:#000;font-size:12px;cursor:pointer">❚❚</span>
        <span id="next" style="cursor:pointer;color:rgba(255,255,255,.5)">▶▶</span>
    </div>
    <div style="justify-self:end"><div id="player" style="width:1px;height:1px;overflow:hidden"></div></div>
</footer>

@section Scripts {
    <script>
        // YouTube IFrame API:播完自動接下一首
        const rows = [...document.querySelectorAll('.iw-track')];
        const ids = rows.map(r => r.dataset.vid);
        let idx = 0, yt = null;

        // 先定義 callback 再載入 API——順序反過來的話,API 若先載完就永遠不會回呼
        window.onYouTubeIframeAPIReady = () => {
            yt = new YT.Player('player', {
                videoId: ids[0], playerVars: { autoplay: 0 },
                events: { onStateChange: e => { if (e.data === YT.PlayerState.ENDED) go(idx + 1); } }
            });
        };
        if (ids.length > 0) {
            const tag = document.createElement('script');
            tag.src = 'https://www.youtube.com/iframe_api';
            document.head.appendChild(tag);
        }

        function go(n) {
            if (ids.length === 0) return;
            idx = (n + ids.length) % ids.length;
            rows.forEach((r, i) => r.classList.toggle('is-on', i === idx));
            const spans = rows[idx].querySelectorAll('span span');
            npTitle.textContent = barTitle.textContent = spans[0].textContent;
            npArtist.textContent = barArtist.textContent = spans[1].textContent;
            yt?.loadVideoById(ids[idx]);
        }
        rows.forEach((r, i) => r.addEventListener('click', () => go(i)));
        prev.onclick = () => go(idx - 1);
        next.onclick = () => go(idx + 1);
        toggle.onclick = () => {
            const s = yt?.getPlayerState();
            if (s === YT.PlayerState.PLAYING) { yt.pauseVideo(); toggle.textContent = '▶'; }
            else { yt?.playVideo(); toggle.textContent = '❚❚'; }
        };
    </script>
}
