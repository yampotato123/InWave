@using InWave.Services
@model InWave.Models.ViewModels.EditViewModel
@{
    ViewData["Title"] = "修圖";

    // 濾鏡的 CSS 與搜尋修飾詞一律取自 PhotoFilters,不在這裡另寫一份——
    // 兩邊各寫一份必然走鐘,README 也特別提醒過這點。英文副標只是顯示用。
    var englishLabel = new Dictionary<string, string>
    {
        ["暖陽"] = "Sunlit", ["冷夜"] = "Cool night", ["褪色"] = "Faded"
    };
    var filterJs = PhotoFilters.All.ToDictionary(f => f.KeywordModifier, f => f.CssFilter);
    var currentModifier = PhotoFilters.Find(Model.FilterName)?.KeywordModifier ?? "none";
}

<div asp-validation-summary="All" class="mb-errors" style="margin:20px 40px 0"></div>

<form asp-action="Edit" method="post" class="iw-edit" id="editForm">
    <input type="hidden" asp-for="PhotoId" />
    <input type="hidden" asp-for="EditedImage" id="editedImage" />

    @*
        銳化用的 SVG 卷積核。canvas 的 ctx.filter 可以吃 url(#id) 並與其他 filter 函式串接
        （2026-08-20 在 Chrome 實測確認）。矩陣的中心值由 JS 依滑桿改寫:
        中心 = 1 + 4a、四邊 = −a，總和恆為 1，所以不會整體變亮或變暗。
    *@
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <filter id="iw-sharpen">
            <feConvolveMatrix id="sharpenKernel" order="3" preserveAlpha="true"
                              kernelMatrix="0 0 0  0 1 0  0 0 0" />
        </filter>
        @*
            色調曲線。tableValues 就是曲線的五個控制點,SVG 會自己在點之間內插,
            所以不需要任何插值計算,也不必逐像素跑 JS——整條曲線是 GPU 在做。
            R/G/B 三通道套同一條(亮度曲線)。
        *@
        <filter id="iw-curve">
            <feComponentTransfer>
                <feFuncR id="curveR" type="table" tableValues="0 0.25 0.5 0.75 1" />
                <feFuncG id="curveG" type="table" tableValues="0 0.25 0.5 0.75 1" />
                <feFuncB id="curveB" type="table" tableValues="0 0.25 0.5 0.75 1" />
            </feComponentTransfer>
        </filter>
    </svg>

    <div class="iw-edit-canvas">
        <div class="frame">
            <canvas id="preview"></canvas>
            <img id="source" src="@Model.PhotoPath" alt="" style="display:none">
        </div>
        <div class="iw-mono" style="display:flex;gap:20px;flex-wrap:wrap;justify-content:center">
            <span>Brightness <b id="vB">@Model.Brightness</b></span>
            <span>Contrast <b id="vC">@Model.Contrast</b></span>
            <span>Saturation <b id="vS">@Model.Saturation</b></span>
            <span>Temp <b id="vT">@Model.Temperature</b></span>
            <span>Sharp <b id="vK">@Model.Sharpness</b></span>
            <span>Soft <b id="vF">@Model.Softness</b></span>
        </div>
    </div>

    <aside class="iw-edit-side">
        <div>
            <div class="iw-mono">Step 02 · 情緒 @(string.IsNullOrEmpty(Model.MoodName) ? "待 AI 判讀" : Model.MoodName)</div>
            <h2 style="margin:12px 0 0;font-size:32px;font-weight:800;letter-spacing:-.03em">修圖 <span style="font-weight:400;color:var(--muted)">Adjust</span></h2>
        </div>

        <div style="display:flex;flex-direction:column;gap:24px">
            <label>
                <span style="display:flex;justify-content:space-between;margin-bottom:11px"><span>亮度 Brightness</span></span>
                <input class="iw-range" type="range" min="0" max="200" asp-for="Brightness" data-k="b" />
            </label>
            <label>
                <span style="display:flex;justify-content:space-between;margin-bottom:11px"><span>對比 Contrast</span></span>
                <input class="iw-range" type="range" min="0" max="200" asp-for="Contrast" data-k="c" />
            </label>
            <label>
                <span style="display:flex;justify-content:space-between;margin-bottom:11px"><span>飽和度 Saturation</span></span>
                <input class="iw-range" type="range" min="0" max="200" asp-for="Saturation" data-k="s" />
            </label>
            <label>
                <span style="display:flex;justify-content:space-between;margin-bottom:11px">
                    <span>色溫 Temperature</span><span class="iw-mono" style="font-size:9px">冷 ↔ 暖</span>
                </span>
                <input class="iw-range" type="range" min="-100" max="100" asp-for="Temperature" data-k="t" />
            </label>
            <label>
                <span style="display:flex;justify-content:space-between;margin-bottom:11px"><span>銳利度 Sharpness</span></span>
                <input class="iw-range" type="range" min="0" max="100" asp-for="Sharpness" data-k="k" />
            </label>
            <label>
                <span style="display:flex;justify-content:space-between;margin-bottom:11px"><span>柔焦 Softness</span></span>
                <input class="iw-range" type="range" min="0" max="100" asp-for="Softness" data-k="f" />
            </label>
        </div>

        <div>
            <div class="iw-mono" style="margin-bottom:12px">色調曲線 Tone curve</div>
            <div style="display:flex;gap:14px;align-items:flex-start">
                <canvas id="curve" width="150" height="150"
                        style="border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.03);
                               touch-action:none;cursor:ns-resize;flex:none"></canvas>
                <div class="iw-mono" style="font-size:9px;line-height:2;color:var(--muted)">
                    上下拖曳五個點<br>
                    左邊＝暗部<br>
                    右邊＝亮部<br>
                    <button type="button" id="curveReset" class="iw-pill" style="margin-top:8px">拉直</button>
                </div>
            </div>
            <input type="hidden" asp-for="CurvePoints" id="curveInput" />
        </div>

        <div>
            <label class="iw-mono" for="PlaylistName" style="display:block;margin-bottom:10px">
                歌單名稱 Playlist name · 會告訴 AI 你想要什麼
            </label>
            <input class="iw-input" asp-for="PlaylistName" maxlength="60" autocomplete="off"
                   placeholder="例:夏天的海邊、下班後的深夜" />
            <div class="iw-mono" style="font-size:9px;margin-top:8px;line-height:1.7;color:var(--muted)">
                取的名字會一起送給 AI —— 它比任何滑桿都更能表達你要的氣氛。留白也可以。
            </div>
        </div>

        <div>
            <div class="iw-mono" style="margin-bottom:14px">濾鏡 Filter · 會影響音樂推薦</div>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px">
                <label class="iw-filter @(PhotoFilters.Find(Model.FilterName) == null ? "is-on" : "")" data-mod="none">
                    <input type="radio" asp-for="FilterName" value="" hidden />
                    <span style="font-size:13px;font-weight:500">不套用</span>
                    <span class="iw-mono" style="font-size:9px;letter-spacing:.14em">none</span>
                </label>
                @foreach (var f in PhotoFilters.All)
                {
                    <label class="iw-filter @(Model.FilterName == f.Name ? "is-on" : "")" data-mod="@f.KeywordModifier">
                        <input type="radio" asp-for="FilterName" value="@f.Name" hidden />
                        <span style="font-size:13px;font-weight:500">@f.Name @englishLabel.GetValueOrDefault(f.Name)</span>
                        <span class="iw-mono" style="font-size:9px;letter-spacing:.14em">@f.KeywordModifier</span>
                    </label>
                }
            </div>
        </div>

        <div style="padding:16px 18px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.03)">
            <div class="iw-mono" style="font-size:9px">搜尋關鍵字 Keyword</div>
            <div id="keyword" style="margin-top:9px;font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--accent)"></div>
        </div>

        <div style="margin-top:auto;display:flex;flex-direction:column;gap:9px">
            <button class="iw-btn" type="submit">完成,取得推薦 →</button>
            <button class="iw-btn iw-btn-ghost" type="button" id="reset">還原 Reset</button>
            <a class="iw-btn iw-btn-ghost" asp-action="Recommend" asp-route-photoId="@Model.PhotoId">略過修圖 Skip</a>
        </div>
    </aside>
</form>

@section Scripts {
    <script>
        // 長邊超過這個像素就縮圖再匯出,否則大照片的 data URL 會超過後端 4MB 的表單欄位上限
        const MAX_EDGE = 1600;

        const img = document.getElementById('source'), cv = document.getElementById('preview'), ctx = cv.getContext('2d');
        // 濾鏡與關鍵字都由伺服器端產生,與 PhotoFilters / MoodKeywordMapper 保證一致
        const CSSF = @Html.Raw(Json.Serialize(filterJs));
        @* 情緒未指定時給 null:GetKeyword 此時會退回 fallback 的 chill music,
           而那不是最終關鍵字(要等 AI 判讀),連送到前端都不該送。
           用 Razor 註解而非 JS 註解,這段說明就不會被送到瀏覽器 *@
        const BASE_KEYWORD = @Html.Raw(Json.Serialize(
            string.IsNullOrEmpty(Model.MoodName) ? (string?)null : MoodKeywordMapper.GetKeyword(Model.MoodName)));
        let mod = @Html.Raw(Json.Serialize(currentModifier));

        const kernel = document.getElementById('sharpenKernel');

        // ── 色調曲線 ──────────────────────────────────────────────
        // 五個控制點,X 固定在 0 / .25 / .5 / .75 / 1,只能上下拖。
        // 這五個 Y 值直接就是 SVG 的 tableValues,不需要任何轉換。
        const IDENTITY = [0, 0.25, 0.5, 0.75, 1];
        const curveCv = document.getElementById('curve');
        const curveCtx = curveCv.getContext('2d');
        const curveInput = document.getElementById('curveInput');
        const funcs = ['curveR', 'curveG', 'curveB'].map(id => document.getElementById(id));

        function parseCurve(s) {
            const a = (s ?? '').split(',').map(Number);
            return (a.length === 5 && a.every(n => Number.isFinite(n) && n >= 0 && n <= 1))
                ? a : IDENTITY.slice();
        }
        let pts = parseCurve(curveInput.value);

        function drawCurve() {
            const w = curveCv.width, h = curveCv.height;
            curveCtx.clearRect(0, 0, w, h);

            // 格線與對角參考線:沒有它們就看不出自己把曲線拉離原點多遠
            curveCtx.strokeStyle = 'rgba(255,255,255,.10)';
            curveCtx.lineWidth = 1;
            for (let i = 1; i < 4; i++) {
                const p = Math.round(i * w / 4) + 0.5;
                curveCtx.beginPath(); curveCtx.moveTo(p, 0); curveCtx.lineTo(p, h); curveCtx.stroke();
                curveCtx.beginPath(); curveCtx.moveTo(0, p); curveCtx.lineTo(w, p); curveCtx.stroke();
            }
            curveCtx.setLineDash([3, 3]);
            curveCtx.beginPath(); curveCtx.moveTo(0, h); curveCtx.lineTo(w, 0); curveCtx.stroke();
            curveCtx.setLineDash([]);

            const x = i => i * (w - 1) / 4;
            const y = v => (1 - v) * (h - 1);

            curveCtx.strokeStyle = getComputedStyle(document.body).getPropertyValue('--accent') || '#9FE8FF';
            curveCtx.lineWidth = 2;
            curveCtx.beginPath();
            curveCtx.moveTo(x(0), y(pts[0]));
            for (let i = 1; i < 5; i++) curveCtx.lineTo(x(i), y(pts[i]));
            curveCtx.stroke();

            curveCtx.fillStyle = '#fff';
            for (let i = 0; i < 5; i++) {
                curveCtx.beginPath();
                curveCtx.arc(x(i), y(pts[i]), 4, 0, Math.PI * 2);
                curveCtx.fill();
            }
        }

        function applyCurve() {
            const table = pts.map(v => v.toFixed(3)).join(' ');
            funcs.forEach(f => f.setAttribute('tableValues', table));
            curveInput.value = pts.map(v => v.toFixed(3)).join(',');
            drawCurve();
            // SVG 濾鏡改了之後 canvas 不會自動重畫,要自己觸發
            draw();
        }

        let dragging = -1;
        function nearestPoint(offsetX) {
            return Math.max(0, Math.min(4, Math.round(offsetX / (curveCv.width - 1) * 4)));
        }
        function setFromPointer(e) {
            const r = curveCv.getBoundingClientRect();
            const yy = (e.clientY - r.top) / r.height;
            pts[dragging] = Math.max(0, Math.min(1, 1 - yy));
            applyCurve();
        }
        curveCv.addEventListener('pointerdown', e => {
            const r = curveCv.getBoundingClientRect();
            dragging = nearestPoint(e.clientX - r.left);
            curveCv.setPointerCapture(e.pointerId);
            setFromPointer(e);
        });
        curveCv.addEventListener('pointermove', e => { if (dragging >= 0) setFromPointer(e); });
        curveCv.addEventListener('pointerup', () => { dragging = -1; });
        curveCv.addEventListener('pointercancel', () => { dragging = -1; });
        document.getElementById('curveReset').addEventListener('click', () => {
            pts = IDENTITY.slice(); applyCurve();
        });

        function vals() {
            const g = k => +document.querySelector(`[data-k=${k}]`).value;
            return { b: g('b'), c: g('c'), s: g('s'), t: g('t'), k: g('k'), f: g('f') };
        }

        // 色溫沒有對應的 CSS filter 函式,用 sepia + hue-rotate 合成:
        // sepia 先把畫面推向暖褐,再用 hue-rotate 決定要偏橘(暖)還是偏藍(冷)。
        // 強度取 |t|,所以 t=0 時完全不套用,避免原圖被無謂地改色。
        function tempFilter(t) {
            if (t === 0) return '';
            const amount = Math.min(Math.abs(t), 100) * 0.45;      // 最多 45% sepia,再多就變舊照片
            const rotate = t > 0 ? -12 * (t / 100) : 190 * (-t / 100);
            return `sepia(${amount.toFixed(1)}%) hue-rotate(${rotate.toFixed(1)}deg)`;
        }

        // 3x3 銳化核。中心 1+4a、四邊 −a,總和恆為 1 → 只提高邊緣對比,不改變整體亮度。
        function setSharpen(k) {
            const a = (k / 100) * 0.8;
            kernel.setAttribute('kernelMatrix', `0 ${-a} 0  ${-a} ${1 + 4 * a} ${-a}  0 ${-a} 0`);
        }

        function draw() {
            const v = vals();
            if (img.naturalWidth) {
                const scale = Math.min(1, MAX_EDGE / Math.max(img.naturalWidth, img.naturalHeight));
                cv.width = Math.round(img.naturalWidth * scale);
                cv.height = Math.round(img.naturalHeight * scale);
            }
            setSharpen(v.k);
            // CSS filter 的同名函式是連乘的,所以濾鏡會疊在滑桿之上,這是預期行為。
            // 銳化放最前面:先銳化再調色,才不會把調色產生的雜訊一起放大。
            const curved = pts.some((p, i) => Math.abs(p - IDENTITY[i]) > 0.001);
            ctx.filter = [
                v.k > 0 ? 'url(#iw-sharpen)' : '',
                curved ? 'url(#iw-curve)' : '',
                `brightness(${v.b}%)`, `contrast(${v.c}%)`, `saturate(${v.s}%)`,
                tempFilter(v.t),
                v.f > 0 ? `blur(${(v.f / 100 * 8).toFixed(2)}px)` : '',
                mod !== 'none' ? CSSF[mod] : ''
            ].filter(Boolean).join(' ');
            ctx.clearRect(0, 0, cv.width, cv.height);
            ctx.drawImage(img, 0, 0, cv.width, cv.height);
            vB.textContent = v.b; vC.textContent = v.c; vS.textContent = v.s;
            vT.textContent = v.t; vK.textContent = v.k; vF.textContent = v.f;
            keyword.textContent = BASE_KEYWORD === null
                ? '由 AI 判讀後決定'
                : BASE_KEYWORD + (mod !== 'none' ? ' ' + mod : '');
        }

        img.onload = draw;
        applyCurve();   // 把存檔的曲線套上 SVG 與畫布,並畫出曲線圖
        if (img.complete && img.naturalWidth) draw();

        document.querySelectorAll('.iw-range').forEach(r => r.addEventListener('input', draw));
        document.querySelectorAll('.iw-filter').forEach(l => l.addEventListener('click', () => {
            document.querySelectorAll('.iw-filter').forEach(x => x.classList.remove('is-on'));
            l.classList.add('is-on'); mod = l.dataset.mod; draw();
        }));
        document.getElementById('reset').addEventListener('click', () => {
            // 三個百分比滑桿的原點是 100,色溫/銳利/柔焦的原點是 0——不能一律設 100
            document.querySelectorAll('.iw-range').forEach(r => {
                r.value = ['b', 'c', 's'].includes(r.dataset.k) ? 100 : 0;
            });
            mod = 'none';
            document.querySelectorAll('.iw-filter').forEach((x, i) => x.classList.toggle('is-on', i === 0));
            document.querySelector('.iw-filter input').checked = true;
            pts = IDENTITY.slice();
            applyCurve();   // 內部會呼叫 draw()
        });
        document.getElementById('editForm').addEventListener('submit', () => {
            document.getElementById('editedImage').value = cv.toDataURL('image/jpeg', 0.85);
        });
    </script>
}
