@model List<MyMusicBuddy.Models.Playlist>
@{
    ViewData["Title"] = "我的作品";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3" style="margin-bottom: 32px">
    <div>
        <h1 class="mb-page-title" style="margin-bottom: 6px">我的作品</h1>
        <span class="mb-muted" style="font-size: 14px">@Model.Count 件</span>
    </div>
    <a asp-action="Create" class="mb-btn">建立新作品</a>
</div>

@if (Model.Count == 0)
{
    <div class="mb-empty">
        還沒有作品——<a asp-action="Create">建立第一個</a>吧!
    </div>
}

@* 每張卡片各自從自己的照片取樣主色,所以這面牆是一片各自不同的顏色 *@
<div class="mb-card-grid">
    @foreach (var playlist in Model)
    {
        <a asp-action="Details" asp-route-id="@playlist.Id" class="mb-card">
            <div class="mb-card-thumb">
                <img src="@(playlist.Photo.EditedPath ?? playlist.Photo.OriginalPath)"
                     data-accent-src data-accent-scope=".mb-card" alt="" />
                <span class="mb-card-play"></span>
            </div>
            <div class="mb-card-title">@playlist.Name</div>
            <div class="mb-card-sub">
                @(playlist.Photo.Mood?.MoodName ?? "—")　・　@playlist.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
            </div>
        </a>
    }
</div>
