@using MyMusicBuddy.Services
@{
    ViewData["Title"] = "建立新作品";
}

<h1 class="mb-page-title">建立新作品</h1>

<div asp-validation-summary="All" class="mb-errors"></div>

<form asp-action="Create" method="post" enctype="multipart/form-data" style="max-width: 640px">
    <div class="mb-4">
        <div class="mb-muted mb-2">1. 選擇照片</div>
        <div class="mb-file-drop">
            <input type="file" class="form-control" id="photoFile" name="photoFile"
                   accept=".jpg,.jpeg,.png,.webp" />
            <div class="mb-muted mt-2" style="font-size: 13px">jpg / png / webp,10 MB 以內</div>
        </div>
    </div>

    <div class="mb-4">
        <div class="mb-muted mb-2">2. 這張照片的情緒是?</div>
        <div class="mb-chips">
            @foreach (var mood in MoodKeywordMapper.AllMoods)
            {
                <input type="radio" class="btn-check" name="moodName" id="mood-@mood"
                       value="@mood" autocomplete="off" />
                <label class="mb-chip" for="mood-@mood">@mood</label>
            }
        </div>
    </div>

    <button type="submit" class="mb-btn">產生推薦歌單</button>
</form>
