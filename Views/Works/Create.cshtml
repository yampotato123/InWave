@using MyMusicBuddy.Services
@{
    ViewData["Title"] = "建立新作品";
}

<h1 class="mb-4">建立新作品</h1>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-8">
    <div class="mb-4">
        <label for="photoFile" class="form-label fw-bold">1. 選擇照片</label>
        <input type="file" class="form-control" id="photoFile" name="photoFile"
               accept=".jpg,.jpeg,.png,.webp" />
        <div class="form-text">jpg / png / webp,10 MB 以內</div>
    </div>

    <div class="mb-4">
        <label class="form-label fw-bold">2. 這張照片的情緒是?</label>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var mood in MoodKeywordMapper.AllMoods)
            {
                <input type="radio" class="btn-check" name="moodName" id="mood-@mood"
                       value="@mood" autocomplete="off" />
                <label class="btn btn-outline-primary" for="mood-@mood">@mood</label>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg">產生推薦歌單</button>
</form>
