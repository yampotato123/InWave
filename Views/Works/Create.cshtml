@using InWave.Services
@{
    ViewData["Title"] = "建立新作品";
}

<main class="iw-page" style="max-width:680px">
    <div class="iw-mono">Step 01</div>
    <h1 class="iw-serif" style="margin:12px 0 34px;font-size:46px;line-height:1.1">建立新作品</h1>

    <div asp-validation-summary="All" class="mb-errors"></div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="iw-mono" style="margin-bottom:12px">一 — 選擇照片</div>
        <div class="iw-glass" style="padding:28px 26px;border-radius:14px">
            <input type="file" class="form-control" id="photoFile" name="photoFile"
                   accept=".jpg,.jpeg,.png,.webp"
                   style="background:transparent;border:none;color:#fff;padding:0" />
            <div class="iw-mono" style="margin-top:14px;font-size:10px">jpg / png / webp · 10 MB 以內</div>
        </div>

        <div class="iw-mono" style="margin:34px 0 12px">二 — 這張照片的情緒是?</div>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
            @* 空值 = 不指定,由 AI 判讀。預設選它:被逼著八選一時使用者只是挑個最接近的,
               那不是意圖卻會錨定 AI(設計文件 §3.2.1) *@
            <input type="radio" class="btn-check" name="moodName" id="mood-auto"
                   value="" autocomplete="off" checked />
            <label class="iw-pill is-on" for="mood-auto" style="cursor:pointer">讓 AI 判斷</label>
            @foreach (var mood in MoodKeywordMapper.AllMoods)
            {
                <input type="radio" class="btn-check" name="moodName" id="mood-@mood"
                       value="@mood" autocomplete="off" />
                <label class="iw-pill" for="mood-@mood" style="cursor:pointer">@mood</label>
            }
        </div>
        <div class="iw-mono" style="margin-top:12px;font-size:10px;color:var(--muted)">
            自己選了就以你的選擇為準;交給 AI 則由照片內容決定
        </div>

        <button type="submit" class="iw-btn" id="submitBtn" style="margin-top:38px">下一步:修圖 →</button>
    </form>
</main>

@section Scripts {
    <script>
        // btn-check 的選取樣式:沿用 iw-pill 的 is-on
        document.querySelectorAll("input[name='moodName']").forEach(r =>
            r.addEventListener('change', () => {
                document.querySelectorAll("label.iw-pill").forEach(l => l.classList.remove('is-on'));
                if (r.checked) document.querySelector(`label[for="${r.id}"]`).classList.add('is-on');
            }));

        // ── 上傳前先在瀏覽器縮圖 ────────────────────────────────────
        // 手機拍的照片動輒 8–12 MB,以前是原尺寸上傳,然後修圖頁又要把那張原圖
        // 整個下載下來才畫得出 canvas——「上傳很久才進到濾鏡」就是這樣來的。
        //
        // 長邊 1600 與 Edit.cshtml 匯出用的 MAX_EDGE 相同,所以成品畫質不受影響;
        // 送給 AI 的 payload 也從十幾 MB 降到幾百 KB。
        // 本來就小於 1600 的圖直接放行,不做無謂的重新編碼。
        const MAX_EDGE = 1600;
        const form = document.querySelector('form[enctype]');
        const fileInput = document.getElementById('photoFile');
        const submitBtn = document.getElementById('submitBtn');

        function loadImage(file) {
            return new Promise((resolve, reject) => {
                const url = URL.createObjectURL(file);
                const im = new Image();
                im.onload = () => { URL.revokeObjectURL(url); resolve(im); };
                im.onerror = () => { URL.revokeObjectURL(url); reject(new Error('decode failed')); };
                im.src = url;
            });
        }

        form.addEventListener('submit', async e => {
            const file = fileInput.files?.[0];
            // 已處理過、沒選檔、或不是圖片 → 放行,讓伺服器端的驗證去處理
            if (!file || form.dataset.resized === '1' || !file.type.startsWith('image/')) return;

            e.preventDefault();
            const original = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = '處理照片中…';

            try {
                const im = await loadImage(file);
                const scale = Math.min(1, MAX_EDGE / Math.max(im.naturalWidth, im.naturalHeight));

                if (scale < 1) {
                    const c = document.createElement('canvas');
                    c.width = Math.round(im.naturalWidth * scale);
                    c.height = Math.round(im.naturalHeight * scale);
                    c.getContext('2d').drawImage(im, 0, 0, c.width, c.height);
                    const blob = await new Promise(r => c.toBlob(r, 'image/jpeg', 0.9));
                    if (blob) {
                        const name = (file.name.replace(/\.[^.]+$/, '') || 'photo') + '.jpg';
                        const dt = new DataTransfer();
                        dt.items.add(new File([blob], name, { type: 'image/jpeg' }));
                        fileInput.files = dt.files;
                    }
                }
            } catch {
                // 縮圖失敗就照原檔送。慢一點總比傳不上去好,10 MB 的上限仍由伺服器把關。
            }

            form.dataset.resized = '1';
            submitBtn.textContent = original;
            form.submit();
        });
    </script>
}
