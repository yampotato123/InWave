<!DOCTYPE html>
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string PillClass(bool on) => "iw-pill" + (on ? " is-on" : "");
}
<html lang="zh-Hant" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InWave</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800&family=Oswald:wght@300;400;500;600;700&family=Instrument+Serif&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@300;400;500;700&family=Noto+Serif+TC:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* site.css 已刪除(49 個 class 只剩 3 個在用,其餘是改版前的 mb-* 遺留),
       還需要的三條規則已併入 inwave.css。scoped CSS 也一併移除,沒有 .cshtml.css 了。 *@
    <link rel="stylesheet" href="~/css/inwave.css" asp-append-version="true" />
</head>
<body class="iw">
    @* 背景:CD 眩光 + 音波環 + 掃描線 *@
    <div class="iw-bg">
        <div class="iw-glare"></div>
        <span class="iw-ripple"></span><span class="iw-ripple"></span><span class="iw-ripple"></span><span class="iw-ripple"></span>
        <div class="iw-scan"></div>
    </div>

    <header class="iw-header">
        <a class="iw-brand" asp-controller="Home" asp-action="Index"><i></i> InWave</a>
        @*
            兩個入口就夠了。先前的「我的歌單」「播放」和右上的「收藏庫」
            三個都指向 Works/Index,同一個地方給三個名字只會讓人猶豫該點哪個。
        *@
        <nav class="iw-nav">
            <a class="@PillClass(controller == "Works" && (action == "Create" || action == "Edit" || action == "Recommend"))"
               asp-controller="Works" asp-action="Create" title="建立歌單">
                <span class="iw-plus" aria-hidden="true">+</span> 建立歌單
            </a>
            <a class="@PillClass(controller == "Works" && (action == "Index" || action == "Details"))"
               asp-controller="Works" asp-action="Index">收藏庫</a>
        </nav>
        <span></span>
    </header>

    @RenderBody()

    @* 判讀/找歌的等待遮罩。預設隱藏,由 data-loading 觸發(site.js);放在 Layout 一份,全站共用。 *@
    <div class="iw-loading" id="iwLoading" role="status" aria-live="polite">
        <div class="card">
            <div class="eq"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="msg" data-loading-text>正在為你的照片配樂…</div>
            <div class="iw-mono sub">AI 正在讀這張照片的氣氛,大約 10–100 秒。請不要關閉或重新整理這個分頁</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
