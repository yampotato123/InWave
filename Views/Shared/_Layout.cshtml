<!DOCTYPE html>
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string PillClass(bool on) => "iw-pill" + (on ? " is-on" : "");
}
<html lang="zh-Hant" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InWave</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800&family=Oswald:wght@300;400;500;600;700&family=Instrument+Serif&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@300;400;500;700&family=Noto+Serif+TC:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* inwave.css 要在 site.css 之後,才能蓋過舊樣式 *@
    <link rel="stylesheet" href="~/css/inwave.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyMusicBuddy.styles.css" asp-append-version="true" />
</head>
<body class="iw">
    @* 背景:CD 眩光 + 音波環 + 掃描線 *@
    <div class="iw-bg">
        <div class="iw-glare"></div>
        <span class="iw-ripple"></span><span class="iw-ripple"></span><span class="iw-ripple"></span><span class="iw-ripple"></span>
        <div class="iw-scan"></div>
    </div>

    <header class="iw-header">
        <a class="iw-brand" asp-controller="Home" asp-action="Index"><i></i> InWave</a>
        <nav class="iw-nav">
            <a class="@PillClass(controller == "Works" && action == "Index")"
               asp-controller="Works" asp-action="Index">一 我的歌單</a>
            <a class="@PillClass(controller == "Works" && (action == "Create" || action == "Edit"))"
               asp-controller="Works" asp-action="Create">二 修圖</a>
            <a class="@PillClass(controller == "Works" && (action == "Details" || action == "Recommend"))"
               asp-controller="Works" asp-action="Index">三 播放</a>
        </nav>
        <div class="iw-mono" style="text-align:right">收藏庫 Library</div>
    </header>

    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
