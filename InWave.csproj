<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>23d905ff-b3e8-4062-88ce-cfa5c7e6c3d9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web SDK 預設遞迴收錄所有 .cs,不排除的話測試專案會被主專案一起編譯 -->
    <Compile Remove="InWave.Tests/**" />
    <Content Remove="InWave.Tests/**" />
    <None Remove="InWave.Tests/**" />

    <!-- InWave 改版前的舊 View 備份。同樣會被遞迴收錄——.cshtml 交給 Razor
         產生器編譯,裡面的舊 @model 型別在改名後就不存在了,不排除會建置失敗。
         (2026-08-11 改名時發現;在此之前它一直被編譯,只是命名空間剛好相同。) -->
    <Compile Remove="backup-before-inwave-*/**" />
    <Content Remove="backup-before-inwave-*/**" />
    <None Remove="backup-before-inwave-*/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- EF Core 10.0.10 傳遞相依的 SQLitePCLRaw 2.1.11 內含 SQLite < 3.50.2,
         有 CVE-2025-6965(聚合函式記憶體損毀,CVSS 7.2)。明確指定 2.1.12 覆寫它。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>


